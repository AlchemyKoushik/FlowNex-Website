{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowNex Lead",
  "type": "object",
  "required": ["lead"],
  "properties": {
    "lead": {
      "type": "object",
      "required": [
        "leadId",
        "idempotencyKey",
        "name",
        "email",
        "preferredDate",
        "preferredTime",
        "timezone",
        "problem",
        "submittedAt",
        "meetingStatus",
        "invitationStatus",
        "processingStatus",
        "source"
      ],
      "properties": {
        "leadId": { "type": "string", "pattern": "^FN-[0-9]{4}-[0-9]{6}$" },
        "idempotencyKey": { "type": "string", "minLength": 16 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email" },
        "preferredDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "preferredTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timezone": { "type": "string" },
        "problem": { "type": "string", "maxLength": 4000 },
        "improvementAreas": { "type": "array", "items": { "type": "string" } },
        "urgency": { "type": "string", "enum": ["", "LOW", "NORMAL", "HIGH", "ASAP"] },
        "voiceRecordingUrl": { "type": ["string", "null"] },
        "voiceRecordingMimeType": { "type": ["string", "null"] },
        "voiceRecordingBytes": { "type": ["number", "null"] },
        "requestedTimeIST": { "type": ["string", "null"] },
        "meetingStatus": {
          "type": "string",
          "enum": ["PENDING", "INVITE_PENDING", "INVITE_SENT", "ACCEPTED", "DECLINED", "CANCELLED", "RESCHEDULE_REQUESTED", "NO_RESPONSE", "COMPLETED", "NO_SHOW"]
        },
        "invitationStatus": { "type": "string", "enum": ["PENDING", "INVITE_SENT", "ACCEPTED", "DECLINED"] },
        "processingStatus": { "type": "string", "enum": ["PROCESSING", "COMPLETED", "FAILED", "CONFIGURATION_REQUIRED"] },
        "source": { "type": "string", "const": "website" }
      },
      "additionalProperties": true
    }
  }
}
