# FlowNex Backend Contract Environment Variables

# The base URL of this FlowNex website (e.g., http://localhost:3000 or https://your-domain.com)
FLOWNEX_PUBLIC_BASE_URL=http://localhost:3000

# Secret used to authenticate the internal Next.js API route that retrieves audio files
FLOWNEX_INTERNAL_API_SECRET=43661fb8bce98cde65eee53f0f8f376a4c1b40dec2b52e8514655b37e2bcac85

# Shared secret used to authenticate webhook requests to n8n
FLOWNEX_N8N_WEBHOOK_SECRET=348ef84695c987b166443dcd7dc67179235f570ac67b6b526fa9ab4c60d26a86

# The n8n webhook URL used to check availability slots
FLOWNEX_N8N_AVAILABILITY_URL=https://n8n.alchemy-research.com/webhook/flownex/availability

# The n8n webhook URL used to submit the actual meeting request form and audio
FLOWNEX_N8N_MEETING_REQUEST_URL=https://n8n.alchemy-research.com/webhook/flownex/meeting-request

